<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.kwrld3939</groupId>
		<artifactId>mini-spring-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>mini-spring-beans</artifactId>
	<name>mini-spring-beans</name>
	<description>BeanDefinition、BeanFactory 接口、注册表、注解与类型转换：本模块对第三方运行时依赖为零</description>

	<!--
	  ADR-0004 约束：本模块不得依赖 spring-*、servlet、jackson、cglib。
	  该约束将在阶段 1 用 maven-enforcer-plugin 的 bannedDependencies 自动断言。
	-->
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  ADR-0004 的验收标准由构建强制，而不是靠评审记得：
	  本模块是框架最底层，必须对应用侧框架零依赖。
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>ban-application-dependencies</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<excludes>
										<exclude>org.springframework:*</exclude>
										<exclude>javax.servlet:*</exclude>
										<exclude>jakarta.servlet:*</exclude>
										<exclude>com.fasterxml.jackson.core:*</exclude>
										<exclude>cglib:*</exclude>
										<exclude>net.sf.cglib:*</exclude>
									</excludes>
									<message>mini-spring-beans 必须对应用侧框架零依赖（ADR-0004）</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
